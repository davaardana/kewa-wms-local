# MOSA IoT RFID Edge Bridge — .env (salin dari .env.example, sesuaikan)

# === Koneksi Edge ke reader RFID fisik ===
READER_HOST=192.168.2.200
READER_PORT=2022
ENABLE_DIRECT_READER=true

# === Identitas lokasi dan gerbang ===
WAREHOUSE_ID=1
GATE_ID=GATE-01
ASSIGNED_ANTENNA=A

# === Port layanan pada komputer Edge ===
TCP_PORT=2077
TCP_PORT_B=2079
WS_PORT=2078
WS_ALLOWED_ORIGINS=http://206.237.98.48,http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# WAJIB sama persis dengan WS_CONTROL_SECRET di backend/.env dan root .env
WS_CONTROL_SECRET=BxfEXBfrzwktwK4gS5ate/9iNn3fKEIsI6pIud7/I3E=

# Isi sama dengan device_code di menu Device Pairing UI
WS_DEVICE_CODE=GATE-01

# === Koneksi Edge ke backend MOSA ===
# Jika edge dijalankan dalam Docker Compose utama:
API_BASE_URL=http://206.237.98.48/api
# Jika edge dijalankan langsung di PC (bukan Docker):
# API_BASE_URL=http://127.0.0.1:8000/api

# Token perangkat — buat di menu Device Pairing > Device API Token, isi di sini
DEVICE_API_TOKEN=cb076bdc01876e19f27b2459db3d324f907d74f9260a2c12bc9bda3f0f19c364

# === Monitoring dan timeout ===
HEARTBEAT_INTERVAL_MS=10000
READER_RESPONSE_TIMEOUT_MS=5000

# === Batching ===
BATCH_IDLE_MS=300
BATCH_DEADLINE_MS=2000
MAX_BATCH_SIZE=100

# === Logging ===
# 'info'  = hanya log penting (gate event, error, health) — untuk production
# 'debug' = log setiap tag scan (120+ baris/menit) — untuk troubleshooting saja
LOG_LEVEL=info

# === RF Power ===
# Daya pancar antenna reader UHF (0-30 dBm). Default 30.
# Naikkan ke 30 untuk jarak baca maksimal. Turunkan untuk area sempit.
RF_POWER_DBM=30

# === Edge-to-Edge Mesh Sync (Fitur #10) ===
# Aktifkan jika ada 2+ gerbang di gudang yang sama
MESH_ENABLED=false
MESH_PORT=2090
