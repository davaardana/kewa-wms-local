# Salin file ini menjadi edge-bridge/.env, lalu ubah nilainya di file tersebut.
# Jika Edge dijalankan lewat Docker Compose utama, variabel dengan nama sama juga
# dapat diatur pada .env di folder root proyek sebelum container dibuat ulang.

# === Koneksi Edge ke reader RFID fisik ===
# Isi sama dengan "IP Address Hardware" pada menu Device Pairing.
# Contoh: jika IP reader RFID = 192.168.1.200, isi READER_HOST=192.168.1.200.
# Setelah DEVICE_API_TOKEN valid, konfigurasi dari backend dapat mengganti nilai awal ini.
READER_HOST=192.168.1.200
# Isi sama dengan "Port TCP/IP" reader pada menu Device Pairing, bukan port komputer Edge.
# Contoh: jika reader mendengarkan pada port 2022, isi READER_PORT=2022. Rentang 1-65535.
READER_PORT=2022
# Isi true jika Edge yang menghubungi IP reader; isi false jika reader yang menghubungi Edge.
# Contoh umum Electron EL-UHF-RC4 mode TCP Server: ENABLE_DIRECT_READER=true.
# Pengaturan hanya ada di edge-bridge/.env; setelah diubah, restart Edge Bridge.
ENABLE_DIRECT_READER=true

# === Identitas lokasi dan gerbang ===
# Isi ID numerik gudang yang dipilih pada menu Device Pairing > Penempatan Gudang/Yard.
# Contoh: URL/data gudang menunjukkan id 1, isi WAREHOUSE_ID=1; jangan isi nama gudang.
# Setelah pairing tersinkron, backend dapat mengganti nilai awal ini.
WAREHOUSE_ID=1
# Isi sama dengan "Kode Unik Device" pada menu Device Pairing.
# Contoh: jika kode di UI = GATE-GUDANG-01, isi GATE_ID=GATE-GUDANG-01.
# Setelah pairing tersinkron, backend dapat mengganti nilai awal ini.
GATE_ID=GATE-01
# Isi A jika proses ini khusus antena masuk A; isi B jika khusus antena keluar B.
# Contoh satu proses dual-port: ASSIGNED_ANTENNA= (kosong), lalu gunakan TCP_PORT dan TCP_PORT_B.
# Pengaturan tidak tersedia di UI; setelah diubah, restart Edge Bridge.
ASSIGNED_ANTENNA=A

# === Port layanan pada komputer Edge ===
# Port komputer Edge yang menerima koneksi Sensor/Reader A, bukan port milik reader.
# Contoh: arahkan reader A ke IP komputer Edge port 2077, lalu isi TCP_PORT=2077.
# Buka port yang sama pada Windows Firewall dan mapping Docker bila Edge memakai container.
TCP_PORT=2077
# Port komputer Edge yang menerima koneksi Sensor/Reader B.
# Contoh: arahkan reader B ke IP komputer Edge port 2079, lalu isi TCP_PORT_B=2079.
# Dipakai hanya saat ASSIGNED_ANTENNA kosong; buka juga pada firewall/mapping Docker.
TCP_PORT_B=2079
# Port WebSocket lokal pada komputer Edge.
# Contoh: isi WS_PORT=2078, lalu atur reverse proxy WSS agar meneruskan ke 127.0.0.1:2078.
# URL publiknya diisi pada menu Device Pairing > URL WebSocket Edge, bukan pada WS_PORT.
WS_PORT=2078
# Isi alamat asal frontend yang boleh membuka WebSocket, dipisahkan koma, tanpa path.
# Contoh production: WS_ALLOWED_ORIGINS=https://wms.example.com
# Contoh development lokal: http://localhost:5173,http://127.0.0.1:5173
# Jangan dikosongkan pada production karena nilai kosong menerima semua origin.
WS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
# Isi secret acak minimum 32 karakter dan salin nilai yang sama ke WS_CONTROL_SECRET backend/root .env.
# Contoh bentuk: WS_CONTROL_SECRET=<secret-acak-panjang>; jangan gunakan contoh sebagai secret nyata.
# Nilai berbeda/kosong membuat tiket kontrol WebSocket ditolak. Restart backend dan Edge setelah diubah.
# Jangan commit secret asli ke Git dan jangan memasukkannya melalui UI.
WS_CONTROL_SECRET=
# Isi persis sama dengan nilai "Kode Unik Device" pada menu Device Pairing.
# Contoh: jika Kode Unik Device di UI = GATE-GUDANG-01, isi WS_DEVICE_CODE=GATE-GUDANG-01.
# Huruf besar/kecil harus sama. Nilai kosong atau berbeda membuat tiket kontrol WebSocket ditolak.
# Isi manual di edge-bridge/.env, lalu restart Edge Bridge; nilai ini tidak tersinkron otomatis.
WS_DEVICE_CODE=
# URL WSS publik/LAN sendiri diatur pada Device Pairing > URL WebSocket Edge, bukan di file ini.

# === Koneksi Edge ke backend MOSA ===
# Isi alamat REST API backend MOSA dan wajib akhiri dengan /api.
# Edge berjalan langsung di Windows: API_BASE_URL=http://127.0.0.1:8000/api
# Edge di Compose utama: API_BASE_URL=http://nginx/api
# Edge di container terpisah: API_BASE_URL=http://host.docker.internal:8000/api
API_BASE_URL=http://127.0.0.1:8000/api
# Buat/isi token minimum 32 karakter pada menu Device Pairing > Device API Token.
# Salin nilai yang sama ke sini, contoh: DEVICE_API_TOKEN=<token-device-yang-dibuat-di-UI>.
# Token kosong/salah membuat heartbeat, event RFID, dan sinkronisasi konfigurasi ditolak backend.
# Backend hanya menyimpan hash; simpan plaintext di edge-bridge/.env, jangan commit ke Git.
DEVICE_API_TOKEN=

# === Monitoring dan timeout ===
# Isi jeda pengiriman status Edge ke backend dalam milidetik.
# Contoh: HEARTBEAT_INTERVAL_MS=10000 berarti heartbeat dikirim setiap 10 detik.
# Ini berbeda dari "Toleransi Heartbeat" pada UI; setelah diubah, restart Edge Bridge.
HEARTBEAT_INTERVAL_MS=10000
# Isi batas waktu reader direct tidak merespons dalam milidetik.
# Contoh: READER_RESPONSE_TIMEOUT_MS=5000 berarti setelah 5 detik tanpa respons, koneksi diulang.
# Pengaturan tidak tersedia di UI; setelah diubah, restart Edge Bridge.
READER_RESPONSE_TIMEOUT_MS=5000
