# ===================================================
# MOSA IoT RFID Edge Bridge — Dual Antenna Gate Example
# ===================================================

# Backend API. Production: https://domain-produksi.com/api
API_BASE_URL=http://127.0.0.1:8000/api

# Per-device token from gate_devices.api_token_hash pair/setup.
# Never put this in frontend.
DEVICE_API_TOKEN=replace-with-device-token

# Same secret as backend/.env WS_CONTROL_SECRET.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WS_CONTROL_SECRET=replace-with-same-backend-secret
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# Warehouse & gate identity
WAREHOUSE_ID=1
GATE_ID=GATE-01
GATE_MODE=DUAL_ANTENNA_AUTO

# Dual antenna TCP listener mode.
# Antenna A = inside/warehouse side. Antenna B = outside/yard side.
# A then B = OUT. B then A = IN.
TCP_PORT=2077
TCP_PORT_B=2079
ASSIGNED_ANTENNA=

# WebSocket for authenticated local live dashboard/control.
WS_PORT=2078

# In dual listener mode, readers connect to this bridge.
# Disable direct single-reader outbound connection.
ENABLE_DIRECT_READER=false

# Only use direct reader mode for single network reader topology.
# READER_HOST=192.168.1.200
# READER_PORT=2022

# Health telemetry
HEARTBEAT_INTERVAL_MS=10000
READER_RESPONSE_TIMEOUT_MS=5000

# Batch grouping
BATCH_IDLE_MS=2500
BATCH_DEADLINE_MS=5000
MAX_BATCH_SIZE=100
