# Copy to a private environment file. Never commit populated secrets.
DB_PASSWORD=replace-with-random-db-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-root-password
WS_CONTROL_SECRET=replace-with-random-secret-at-least-32-bytes
DEVICE_API_TOKEN=replace-with-unique-device-token-at-least-32-characters
WS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CLOUDFLARE_TUNNEL_TOKEN=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306
EDGE_BIND=127.0.0.1
